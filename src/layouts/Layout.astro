---
import '../styles/global.css';
---
<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Nicolás Cerón | Desarrollador Web Full-Stack</title>
	</head>
	<body class="bg-slate-900 text-slate-400 font-sans leading-relaxed selection:bg-teal-300 selection:text-teal-900 antialiased">
    <!-- Spotlight Premium Effect -->
    <div 
      id="spotlight" 
      class="pointer-events-none fixed inset-0 z-50" 
      style="background: radial-gradient(circle var(--spotlight-size, 40px) at var(--x, 0px) var(--y, 0px), rgba(45, 212, 191, 0.15), transparent 80%);"
    ></div>
		
    <slot />

    <style is:global>
      /* CSS Houdini para animar variables personalizadas */
      @property --spotlight-size {
        syntax: '<length>';
        inherits: true;
        initial-value: 40px;
      }

      /* Ocultar cursor nativo en toda la aplicación */
      * {
        cursor: none !important;
      }

      /* Asegurar que los elementos interactivos sigan permitiendo clics pero sin cursor */
      a, button, .group {
        cursor: none !important;
      }

      /* Tech marquee animation */
      .tech-marquee {
        mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
      }

      .tech-track {
        animation: marquee 50s linear infinite;
        width: max-content;
      }

      @keyframes marquee {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-25%);
        }
      }

      .tech-card {
        min-width: 160px;
      }
    </style>

    <script>
      const spotlight = document.getElementById('spotlight');
      const interactiveElements = document.querySelectorAll('a, button, .group');
      
      let mouseX = 0;
      let mouseY = 0;

      // Actualización de posición optimizada sin lag
      const updatePosition = () => {
        if (spotlight) {
          spotlight.style.setProperty('--x', `${mouseX}px`);
          spotlight.style.setProperty('--y', `${mouseY}px`);
        }
        requestAnimationFrame(updatePosition);
      };

      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      // Iniciar el loop de animación para la posición
      requestAnimationFrame(updatePosition);

      // Lógica de expansión orgánica (Tamaño moderado para sensación premium)
      interactiveElements.forEach(el => {
        el.addEventListener('mouseenter', () => {
          spotlight?.style.setProperty('--spotlight-size', '150px');
        });
        el.addEventListener('mouseleave', () => {
          spotlight?.style.setProperty('--spotlight-size', '40px');
        });
      });
    </script>
	</body>
</html>

<style>
  #spotlight {
    transition: --spotlight-size 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
